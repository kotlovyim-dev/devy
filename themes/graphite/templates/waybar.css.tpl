/* Generated by devy-theme ({{theme_name}}). Imported by ~/.config/waybar/style.css */
@define-color base {{base}};
@define-color mantle {{mantle}};
@define-color surface {{surface}};
@define-color overlay {{overlay}};
@define-color subtext {{subtext}};
@define-color text {{text}};
@define-color accent {{accent}};
@define-color success {{success}};
@define-color warning {{warning}};
@define-color error {{error}};

* { font-family: "{{font_ui}}", "{{font_mono}}", sans-serif; }
window#waybar, tooltip { border-radius: {{radius}}px; }
#language, #clock { font-family: "{{font_mono}}"; }
