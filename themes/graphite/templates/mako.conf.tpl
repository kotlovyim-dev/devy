# Generated by devy-theme ({{theme_name}}). ~/.config/mako/config links here.
font={{font_ui}} {{font_ui_size}}
background-color={{surface}}ee
text-color={{text}}
border-color={{overlay}}
progress-color=over {{accent}}
border-size=1
border-radius={{radius}}
padding=12,14
margin=10
width=360
max-visible=4
default-timeout=6000
layer=overlay
anchor=top-right
icons=1
max-icon-size=40

[urgency=low]
default-timeout=3000

[urgency=critical]
border-color={{error}}
default-timeout=0

# Do-Not-Disturb mode (toggled by `devy-menu dnd`): hide everything except critical.
[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
