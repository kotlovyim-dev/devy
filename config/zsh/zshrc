# Devy — interactive zsh. Goal: < 50 ms startup (measure: `devy-doctor --shell`).
# Plugins come from Arch packages (no plugin manager = nothing to download at startup).
# Put personal additions in ~/.zshrc.local.

# --- history ------------------------------------------------------------------
HISTFILE=${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE SHARE_HISTORY EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP

# --- completion (cache rebuilt at most once a day) -----------------------------------
autoload -Uz compinit
_zcomp=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump
[[ -d ${_zcomp:h} ]] || mkdir -p ${_zcomp:h}
if [[ -n ${_zcomp}(#qN.mh+24) || ! -f $_zcomp ]]; then compinit -d $_zcomp; else compinit -C -d $_zcomp; fi
unset _zcomp
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# --- keys ------------------------------------------------------------------------------
bindkey -e
bindkey '^[[1;5C' forward-word   # Ctrl+Right
bindkey '^[[1;5D' backward-word  # Ctrl+Left

# --- tools ---------------------------------------------------------------------------------
(( $+commands[mise] ))     && eval "$(mise activate zsh)"
(( $+commands[zoxide] ))   && eval "$(zoxide init zsh --cmd cd)"
(( $+commands[fzf] ))      && source <(fzf --zsh)
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[direnv] ))   && eval "$(direnv hook zsh)"

# --- aliases ----------------------------------------------------------------------------------
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lh --group-directories-first --icons=auto --git'
  alias la='ll -a'
  alias lt='eza --tree --level=2 --icons=auto'
fi
(( $+commands[bat] )) && alias cat='bat --paging=never --style=plain'
alias g='git' lg='lazygit' ld='lazydocker' dc='docker compose' v='nvim'
alias update='devy-update'

# --- plugins (must be last; syntax highlighting after everything else) ---------------------------
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
