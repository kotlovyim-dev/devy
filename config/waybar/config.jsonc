// Devy — Waybar. Requires Waybar >= 0.16.0 (workspace clicks with Hyprland's Lua config).
// Colors/fonts: style.css imports ~/.config/devy/current/waybar.css (generated by devy-theme).
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "hyprland/language",
    "cpu",
    "memory",
    "temperature",
    "wireplumber",
    "bluetooth",
    "network",
    "battery",
    "custom/notifications",
    "custom/power"
  ],

  "custom/logo": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "default": "", "active": "", "empty": "" },
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true
  },

  "hyprland/language": {
    // Shows which layout is active: EN / UA. Click to switch.
    "format": "{}",
    "format-en": "EN",
    "format-uk": "UA",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "weeks-pos": "left", "on-scroll": 1 },
    "timezone": "Europe/Kyiv"
  },

  "cpu": { "interval": 5, "format": " {usage}%", "on-click": "uwsm app -- ghostty -e btop" },
  "memory": { "interval": 5, "format": " {percentage}%", "tooltip-format": "{used:0.1f} / {total:0.1f} GiB used" },
  "temperature": { "interval": 5, "critical-threshold": 90, "format": " {temperatureC}°" },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["", "", ""],
    "on-click": "uwsm app -- pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": " {num_connections}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "uwsm app -- blueman-manager"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "uwsm app -- nm-connection-editor"
  },

  "battery": {
    "interval": 30,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "{timeTo}, {power:.1f} W"
  },

  "tray": { "icon-size": 15, "spacing": 8 },

  "custom/notifications": {
    // Bell shows when Do-Not-Disturb is off, crossed bell when on.
    "exec": "devy-menu dnd-status",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "on-click": "makoctl restore",
    "on-click-right": "devy-menu dnd"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "devy-menu power"
  }
}
